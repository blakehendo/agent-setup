# Copy to .env and fill in. Then: source .env
# Or put the exports in ~/.zshrc so every Claude Code session is traced.

# ---------------------------------------------------------------------------
# Langfuse — agent observability.
# Claude Code has OpenTelemetry built into the CLI. No SDK, no code.
# Free tier: 50k units/month. Sign up at https://cloud.langfuse.com
#
# After creating a project, get your public (pk-lf-...) and secret (sk-lf-...)
# keys, then generate the auth header:
#   echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# ---------------------------------------------------------------------------

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic PASTE_YOUR_BASE64_HERE"

# Content is NOT captured by default — only metrics and span names.
# These turn on prompts and tool details. Fine for personal work; think
# twice before enabling on anything with other people's data in it.
export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_TOOL_DETAILS=1

# ---------------------------------------------------------------------------
# Model API keys — for promptfoo, which calls providers directly.
# ---------------------------------------------------------------------------
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=
export GOOGLE_API_KEY=
